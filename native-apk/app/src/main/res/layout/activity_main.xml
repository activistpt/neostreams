<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEOSTREAMS"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/cp_secondary"
        android:layout_marginBottom="4dp"
        android:letterSpacing="0.2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEURAL GATEWAY ACCESS"
        android:textSize="14sp"
        android:textColor="@color/cp_text_secondary"
        android:layout_marginBottom="32dp"
        android:letterSpacing="0.1" />

    <EditText
        android:id="@+id/usernameEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/username_hint"
        android:inputType="text"
        android:textColor="@color/cp_text_primary"
        android:textColorHint="@color/cp_primary"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_cyber"
        android:letterSpacing="0.1" />

    <EditText
        android:id="@+id/passwordEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:textColor="@color/cp_text_primary"
        android:textColorHint="@color/cp_primary"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/edit_text_cyber"
        android:letterSpacing="0.1" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/cp_secondary" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_button"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/cp_text_primary"
        android:padding="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_primary"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/cp_text_secondary"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>
