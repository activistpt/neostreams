{
  "name": "neostreams-native-apk",
  "version": "1.0.0",
  "description": "NeoStreams Native Android APK Client",
  "main": "build.gradle",
  "scripts": {
    "build": "./build_neostreams_apk.sh .",
    "verify": "echo 'Verify the generated APK with apksigner.bat verify --verbose --print-certs build/apk/NeoStreams.apk'"
  },
  "keywords": [
    "android",
    "apk",
    "neostreams",
    "iptv",
    "streaming"
  ],
  "author": "NeoStreams Team",
  "license": "MIT",
  "android": {
    "sdk": "36.0.0",
    "platform": "android-37.0",
    "compileSdkVersion": 37,
    "targetSdkVersion": 37,
    "minSdkVersion": 24
  },
  "gson": {
    "version": "2.8.9"
  },
  "dependencies": {
    "com.google.code.gson": "gson-2.8.9.jar"
  }
}